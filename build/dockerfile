# =========================
# BUILD STAGE
# =========================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Projektdateien für Cache
COPY StockTV.slnx .
COPY StockTvBlazor/*.csproj StockTvBlazor/

RUN dotnet restore StockTvBlazor/StockTvBlazor.csproj

# Rest kopieren
COPY . .

# Quelle der Releases fuer die Update-Pruefung (besitzer/repository); docker.yml setzt das Repository des Builds.
ARG STOCKTV_REPOSITORY=Trawacho/StockTV
RUN dotnet publish StockTvBlazor/StockTvBlazor.csproj -c Release -o /app/publish -p:UseAppHost=false -p:StockTvRepository=${STOCKTV_REPOSITORY}

# =========================
# RUNTIME STAGE
# =========================
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 8080

ENTRYPOINT ["dotnet", "StockTvBlazor.dll"]